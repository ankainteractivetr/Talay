# =============================================================================
# Talay — C++20 / WinUI 3 (Windows App SDK), MSBuild + Inno Setup
# =============================================================================

# -----------------------------------------------------------------------------
# Visual Studio build output
# -----------------------------------------------------------------------------
[Dd]ebug/
[Rr]elease/
x64/
x86/
ARM/
ARM64/
[Bb]in/
[Oo]bj/
*.user
*.suo
*.userosscache
*.sln.docstates
*.VC.db
*.VC.opendb

# -----------------------------------------------------------------------------
# Visual Studio IDE noise (keep .sln, .vcxproj, .vcxproj.filters)
# -----------------------------------------------------------------------------
.vs/
enc_temp_folder/
*.ncb
*.sdf
*.opensdf
*.cachefile
*.aps
ipch/

# -----------------------------------------------------------------------------
# Windows App SDK / WinUI 3 generated files
# -----------------------------------------------------------------------------
# C++/WinRT + XAML compiler outputs
Generated Files/
_generated/
*.g.h
*.g.cpp
*.g.cs
XamlTypeInfo.g.cpp

# Package layout & AppX/MSIX artefacts (unpackaged app, kept out regardless)
AppPackages/
AppX/
# Auto-generated at build; the committed source of truth is Package.appxmanifest
AppxManifest.xml
*.appx
*.msix
*.msixbundle
*.appxbundle
*.appxupload
*.wapproj.user

# Windows Metadata & compiled resource index (generated by build / MakePri)
*.winmd
*.pri
*.resfiles

# -----------------------------------------------------------------------------
# NuGet packages (restored from packages.config — keep the config, not the cache)
# -----------------------------------------------------------------------------
packages/
.nuget/
*.nupkg

# -----------------------------------------------------------------------------
# Compiled object & linker artefacts
# -----------------------------------------------------------------------------
*.obj
*.o
*.pch
*.pdb
*.idb
*.ilk
*.lib
*.exp
*.dll
*.exe
*.map
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh

# -----------------------------------------------------------------------------
# Nested same-name intermediate folder (VS drops Talay/Talay/ build cruft).
# Matches any directory literally named "Talay" at any depth below the root;
# the repository root itself is never matched, so project files stay tracked.
# -----------------------------------------------------------------------------
**/Talay/

# -----------------------------------------------------------------------------
# Inno Setup compiled installer output (Talay.iss is the kept source)
# -----------------------------------------------------------------------------
/installer/*.exe
/installer/*.zip

# Temporary cleanup / backup scratch folder
/_cleanup_backup/

# -----------------------------------------------------------------------------
# Code analysis, profiling & test results
# -----------------------------------------------------------------------------
*.nativecodeanalysis.xml
*.vsp
*.vspx
*.sap
*.psess
TestResults/
*.trx
*.coverage
*.coveragexml

# -----------------------------------------------------------------------------
# Log & crash files
# -----------------------------------------------------------------------------
*.log
*.tlog/
*.lastbuildstate
*.dmp
crash_*.dmp

# -----------------------------------------------------------------------------
# Vendored third-party libraries (libs/FreeImage, …)
# These MUST be committed despite the *.lib / *.dll rules above — anything in
# libs/ is a shipped dependency, not a build artefact.
# -----------------------------------------------------------------------------
!libs/**/*.lib
!libs/**/*.dll

# -----------------------------------------------------------------------------
# Editor / OS noise
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
*.orig
*.bak
*.tmp
*~
