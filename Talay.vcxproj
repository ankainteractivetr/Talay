    <!--
      Self-contained: bundle the Windows App SDK runtime DLLs next to Talay.exe
      so the app runs on a clean machine with no separate runtime install.
      Required for a stand-alone classic installer (setup.exe).
    -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!--
      Talay uses only WinUI + the core runtime. The Widgets, AI and ML modules
      are intentionally not referenced (see packages.config), so this opts out
