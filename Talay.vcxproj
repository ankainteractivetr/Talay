  <!-- =========================================================================
       Release: make the build emit a runtime-only OutDir directly, with no
       separate staging step.

       The Windows App SDK self-contained copy
       (AddMicrosoftWindowsAppSDKPayloadFilesFromComponents in
       Microsoft.WindowsAppSDK.SelfContained.targets) drops framework metadata
       (*.winmd), a design-time helper (Microsoft.UI.Designer.dll) and WinUI
       control-string resources for ~85 display languages into OutDir as
       PreserveNewest payload. None are loaded at runtime by this native
       C++/WinRT app, and the SDK exposes no working opt-out, so they are
       removed here after they land. The PDB is kept (redirected to ..\Symbols
       by the Release ItemDefinitionGroup above) for crash symbolication.

       This runs on every Release build; once the SDK copy is satisfied,
       incremental builds skip it and the deletions below become no-ops.
       ========================================================================= -->
  <Target Name="EnsureSymbolsDir" BeforeTargets="Link" Condition="'$(Configuration)'=='Release'">
    <MakeDir Directories="$(OutDir)..\Symbols" />
  </Target>
  <Target Name="TrimReleaseOutput" AfterTargets="Build" Condition="'$(Configuration)'=='Release'">
    <ItemGroup>
      <!-- Compile-time metadata (framework + the app's own Talay.winmd) and the
           linker import-library side-effects; none are read at runtime. -->
      <_TrimFile Include="$(OutDir)*.winmd" />
      <_TrimFile Include="$(OutDir)$(TargetName).lib" />
      <_TrimFile Include="$(OutDir)$(TargetName).exp" />
      <!-- Visual Studio design-time helper (Windows App SDK InteractiveExperiences). -->
      <_TrimFile Include="$(OutDir)Microsoft.UI.Designer.dll" />
    </ItemGroup>
    <Delete Files="@(_TrimFile)" TreatErrorsAsWarnings="true" />
    <!-- Keep only the languages Talay localizes to; every other WinUI language
         falls back to en-US. A directory is a language pack iff it holds the
         xaml .mui marker, so Assets, Styles and Microsoft.UI.Xaml are spared. -->
    <ItemGroup>
      <!-- Step 1: list every immediate subfolder. No metadata Condition here; a
           Condition that reads %(Identity) on a list-valued Include does not
           batch per item, so it would silently match nothing. -->
      <_OutDirSubDir Include="$([System.IO.Directory]::GetDirectories('$(OutDir)'))" />
      <!-- Step 2: of those existing items (which DO batch), keep the language
           packs (folders holding the xaml .mui marker) only for en-us and
           tr-TR; queue the rest for removal. -->
      <_LangDirToTrim Include="@(_OutDirSubDir)"
                      Condition="$([System.IO.File]::Exists('%(Identity)\Microsoft.ui.xaml.dll.mui')) AND '%(Filename)' != 'en-us' AND '%(Filename)' != 'tr-TR'" />
    </ItemGroup>
    <RemoveDir Directories="@(_LangDirToTrim)" />
    <Message Importance="high"
             Text="TrimReleaseOutput: pruned metadata, design-time and unused-language files from $(OutDir)" />
  </Target>
