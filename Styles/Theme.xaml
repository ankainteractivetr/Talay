<?xml version="1.0" encoding="utf-8"?>

<!--
    Talay chrome theme — the "Su Tanrısı" palette applied to the framework
    controls the app reuses (ContentDialog, MenuFlyout). It is merged at the
    application scope on purpose: flyouts and dialogs live in their own popups
    and resolve resources against Application.Resources, not MainWindow's local
    tree, so theming them anywhere else would not take effect.

    Behaviour lives in code (anka::GUI::Dialog::ODialogService); only the look
    lives here.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ DIALOG BUTTONS ═══════════════════════════════════════════════════════
         Scoped to the dialog via ContentDialog.*ButtonStyle so the rest of the app
         keeps the system Button look. Primary = cyan call-to-action, Neutral =
         quiet abyss panel for Close / No. -->
    <Style x:Key="TalayDialogPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#02101A"/>
        <Setter Property="BorderBrush" Value="#5AF2DD"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="20,8"/>
        <Setter Property="MinWidth" Value="104"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="80"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#5AF2DD" Offset="0"/>
                    <GradientStop Color="#27C2E0" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="CP"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.90"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.78"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.40"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TalayDialogNeutralButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#BFE6E2"/>
        <Setter Property="Background" Value="#66081E2A"/>
        <Setter Property="BorderBrush" Value="#403FE0C8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="20,8"/>
        <Setter Property="MinWidth" Value="104"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CharacterSpacing" Value="80"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Border.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.14"/>
                        </Border.BackgroundTransition>
                        <ContentPresenter x:Name="CP"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#33113248"/>
                                        <Setter Target="Root.BorderBrush" Value="#733FE0C8"/>
                                        <Setter Target="CP.Foreground" Value="#5AF2DD"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#22081014"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.40"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ CONTENT DIALOG ═══════════════════════════════════════════════════════
         The surface is painted through theme-resource overrides because the stock
         ContentDialog template binds those keys (not the control's Background), so
         a plain Style setter would never reach the frame. -->
    <LinearGradientBrush x:Key="ContentDialogBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F50E2636" Offset="0"/>
        <GradientStop Color="#F7061A28" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ContentDialogForeground" Color="#BFE6E2"/>
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#663FE0C8"/>
    <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#263FE0C8"/>
    <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#D9020A12"/>

    <Style x:Key="TalayContentDialogStyle" TargetType="ContentDialog">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#BFE6E2"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="PrimaryButtonStyle" Value="{StaticResource TalayDialogPrimaryButtonStyle}"/>
        <Setter Property="SecondaryButtonStyle" Value="{StaticResource TalayDialogNeutralButtonStyle}"/>
        <Setter Property="CloseButtonStyle" Value="{StaticResource TalayDialogNeutralButtonStyle}"/>
    </Style>

    <!-- ═══ MENU FLYOUTS ═════════════════════════════════════════════════════════
         MainWindow's File / Effects / Help menus. Recoloured purely through the
         documented theme-resource keys, so no structural XAML changes are needed
         and every menu (including future ones) inherits the look. -->
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#F7071A26"/>
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#423FE0C8"/>
    <Thickness x:Key="MenuFlyoutPresenterBorderThemeThickness">1</Thickness>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

    <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#1F3FE0C8"/>
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#333FE0C8"/>
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#BFE6E2"/>
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#5AF2DD"/>
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#5AF2DD"/>
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#4D6F9AA3"/>
    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#6F9AA3"/>
    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="#5AF2DD"/>
    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" Color="#5AF2DD"/>

    <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#263FE0C8"/>

    <SolidColorBrush x:Key="MenuFlyoutSubItemBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundPointerOver" Color="#1F3FE0C8"/>
    <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundPressed" Color="#333FE0C8"/>
    <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" Color="#1F3FE0C8"/>
    <SolidColorBrush x:Key="MenuFlyoutSubItemForeground" Color="#BFE6E2"/>
    <SolidColorBrush x:Key="MenuFlyoutSubItemForegroundPointerOver" Color="#5AF2DD"/>
    <SolidColorBrush x:Key="MenuFlyoutSubItemForegroundPressed" Color="#5AF2DD"/>
    <SolidColorBrush x:Key="MenuFlyoutSubItemForegroundSubMenuOpened" Color="#5AF2DD"/>
    <SolidColorBrush x:Key="MenuFlyoutSubItemForegroundDisabled" Color="#4D6F9AA3"/>
    <SolidColorBrush x:Key="MenuFlyoutSubItemChevron" Color="#6F9AA3"/>
    <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPointerOver" Color="#5AF2DD"/>
    <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPressed" Color="#5AF2DD"/>
    <SolidColorBrush x:Key="MenuFlyoutSubItemChevronSubMenuOpened" Color="#5AF2DD"/>

</ResourceDictionary>
