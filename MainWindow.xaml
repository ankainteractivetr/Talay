<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Talay.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Talay"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Talay">

    <!-- TODO: bundle Cinzel, Chakra Petch, Share Tech Mono in Assets/Fonts/ and replace Georgia/Segoe UI/Consolas -->

    <!-- ═══ ROOT GRID ══════════════════════════════════════════════════════════ -->
    <!-- At construction the window slips an OCursorHost between itself and this
         grid (in code, see InitializeCursors) so one ProtectedCursor can serve
         the whole tree: a hand over clickables, a move cursor over a pannable
         image. -->
    <Grid x:Name="RootGrid" RequestedTheme="Dark">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0D3344" Offset="0"/>
                <GradientStop Color="#061B2C" Offset="0.45"/>
                <GradientStop Color="#02101A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.Resources>

        <!-- ═══ COLORS ══════════════════════════════════════════════════════════ -->
        <Color x:Key="AbyssColor">#02101A</Color>
        <Color x:Key="Abyss1Color">#06182A</Color>
        <Color x:Key="Abyss2Color">#0A2638</Color>
        <Color x:Key="CyanColor">#3FE0C8</Color>
        <Color x:Key="CyanBrightColor">#5AF2DD</Color>
        <Color x:Key="AquaColor">#27C2E0</Color>
        <Color x:Key="GoldColor">#E9B765</Color>
        <Color x:Key="GoldBrightColor">#FFD589</Color>
        <Color x:Key="FoamColor">#DBF7F1</Color>
        <Color x:Key="TextColor">#BFE6E2</Color>
        <Color x:Key="DimColor">#6F9AA3</Color>
        <Color x:Key="CoralColor">#FF6F6B</Color>

        <!-- ═══ BRUSHES ══════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="AbyssBrush"      Color="{StaticResource AbyssColor}"/>
        <SolidColorBrush x:Key="Abyss1Brush"     Color="{StaticResource Abyss1Color}"/>
        <SolidColorBrush x:Key="CyanBrush"       Color="{StaticResource CyanColor}"/>
        <SolidColorBrush x:Key="CyanBrightBrush" Color="{StaticResource CyanBrightColor}"/>
        <SolidColorBrush x:Key="GoldBrush"       Color="{StaticResource GoldColor}"/>
        <SolidColorBrush x:Key="GoldBrightBrush" Color="{StaticResource GoldBrightColor}"/>
        <SolidColorBrush x:Key="FoamBrush"       Color="{StaticResource FoamColor}"/>
        <SolidColorBrush x:Key="TextBrush"       Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="DimBrush"        Color="{StaticResource DimColor}"/>
        <SolidColorBrush x:Key="CoralBrush"      Color="{StaticResource CoralColor}"/>
        <!-- Panel + edge -->
        <SolidColorBrush x:Key="PanelBrush"  Color="#99081C2A"/>
        <SolidColorBrush x:Key="EdgeBrush"   Color="#423FE0C8"/>
        <!-- Toolbar button gradient backgrounds -->
        <LinearGradientBrush x:Key="TbtnNormalBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#7F143848" Offset="0"/>
            <GradientStop Color="#7F081E2A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TbtnHoverBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#A61C4C5E" Offset="0"/>
            <GradientStop Color="#A60A2634" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TbtnGoldActiveBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8C4A3A1E" Offset="0"/>
            <GradientStop Color="#8C281E0C" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TbtnCyanActiveBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E62A8EA6" Offset="0"/>
            <GradientStop Color="#E60F4150" Offset="1"/>
        </LinearGradientBrush>
        <!-- Window background -->
        <LinearGradientBrush x:Key="WindowBgBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0D3344" Offset="0"/>
            <GradientStop Color="#061B2C" Offset="0.45"/>
            <GradientStop Color="#02101A" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══ CORNER RADIUS ════════════════════════════════════════════════════ -->
        <CornerRadius x:Key="BtnRadius">9</CornerRadius>
        <CornerRadius x:Key="PanelRadius">12</CornerRadius>
        <CornerRadius x:Key="HudRadius">7</CornerRadius>

        <!-- ═══ STYLE: Window control buttons (min / max) ════════════════════════ -->
        <Style x:Key="WinCtrlStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="#66081E2A"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="BorderBrush" Value="#293FE0C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.BackgroundTransition>
                                <BrushTransition Duration="0:0:0.14"/>
                            </Border.BackgroundTransition>
                            <ContentPresenter x:Name="CP"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#331C3A4F"/>
                                            <Setter Target="Root.BorderBrush" Value="#733FE0C8"/>
                                            <Setter Target="CP.Foreground" Value="{StaticResource CyanBrightBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#22081014"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ STYLE: Close button (red hover) ═════════════════════════════════ -->
        <Style x:Key="WinCtrlCloseStyle" TargetType="Button" BasedOn="{StaticResource WinCtrlStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.BackgroundTransition>
                                <BrushTransition Duration="0:0:0.14"/>
                            </Border.BackgroundTransition>
                            <ContentPresenter x:Name="CP"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#2DFF6F6B"/>
                                            <Setter Target="Root.BorderBrush" Value="#99FF6F6B"/>
                                            <Setter Target="CP.Foreground" Value="White"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#44FF6F6B"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ STYLE: Menu bar buttons ══════════════════════════════════════════ -->
        <Style x:Key="MenuBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7,12,8"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CharacterSpacing" Value="125"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Border.BackgroundTransition>
                                <BrushTransition Duration="0:0:0.14"/>
                            </Border.BackgroundTransition>
                            <Grid>
                                <ContentPresenter x:Name="CP"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}"/>
                                <Rectangle x:Name="Underline"
                                           VerticalAlignment="Bottom" Height="1"
                                           HorizontalAlignment="Stretch" Margin="2,0,2,0"
                                           Opacity="0">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="#3FE0C8" Offset="0.3"/>
                                            <GradientStop Color="#5AF2DD" Offset="0.5"/>
                                            <GradientStop Color="#3FE0C8" Offset="0.7"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#113248"/>
                                            <Setter Target="CP.Foreground" Value="{StaticResource CyanBrightBrush}"/>
                                            <Setter Target="Underline.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#0A1C28"/>
                                            <Setter Target="CP.Foreground" Value="{StaticResource CyanBrush}"/>
                                            <Setter Target="Underline.Opacity" Value="0.6"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ STYLE: Toolbar ToggleButton – gold active ════════════════════════ -->
        <Style x:Key="TbtnGoldStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource TbtnNormalBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#2E3FE0C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource BtnRadius}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Border.BackgroundTransition><BrushTransition Duration="0:0:0.16"/></Border.BackgroundTransition>
                            <ContentPresenter x:Name="CP"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <!-- One group on purpose: WinUI's ToggleButton only ever targets the
                                     combined states (Normal…Pressed / Checked…CheckedPressed) — a
                                     WPF-style "CheckStates" group is never driven, so checked visuals
                                     would stick or never apply when IsChecked is set from code. -->
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource TbtnHoverBg}"/>
                                            <Setter Target="Root.BorderBrush" Value="#733FE0C8"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#20081420"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource TbtnGoldActiveBg}"/>
                                            <Setter Target="Root.BorderBrush" Value="#99E9B765"/>
                                            <Setter Target="CP.Foreground" Value="{StaticResource GoldBrightBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource TbtnGoldActiveBg}"/>
                                            <Setter Target="Root.BorderBrush" Value="#CCE9B765"/>
                                            <Setter Target="CP.Foreground" Value="{StaticResource GoldBrightBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#20081420"/>
                                            <Setter Target="Root.BorderBrush" Value="#99E9B765"/>
                                            <Setter Target="CP.Foreground" Value="{StaticResource GoldBrightBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ STYLE: Toolbar ToggleButton – cyan active ════════════════════════ -->
        <Style x:Key="TbtnCyanStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource TbtnNormalBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#2E3FE0C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource BtnRadius}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Border.BackgroundTransition><BrushTransition Duration="0:0:0.16"/></Border.BackgroundTransition>
                            <ContentPresenter x:Name="CP"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <!-- One group on purpose — see TbtnGoldStyle: WinUI's ToggleButton
                                     never drives a separate "CheckStates" group. -->
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource TbtnHoverBg}"/>
                                            <Setter Target="Root.BorderBrush" Value="#733FE0C8"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#20081420"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource TbtnCyanActiveBg}"/>
                                            <Setter Target="Root.BorderBrush" Value="#993FE0C8"/>
                                            <Setter Target="CP.Foreground" Value="{StaticResource CyanBrightBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource TbtnCyanActiveBg}"/>
                                            <Setter Target="Root.BorderBrush" Value="#CC3FE0C8"/>
                                            <Setter Target="CP.Foreground" Value="{StaticResource CyanBrightBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#20081420"/>
                                            <Setter Target="Root.BorderBrush" Value="#993FE0C8"/>
                                            <Setter Target="CP.Foreground" Value="{StaticResource CyanBrightBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ STYLE: Toolbar Button (non-toggle, hover only) ══════════════════ -->
        <Style x:Key="TbtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource TbtnNormalBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#2E3FE0C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource BtnRadius}"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Border.BackgroundTransition><BrushTransition Duration="0:0:0.16"/></Border.BackgroundTransition>
                            <ContentPresenter x:Name="CP"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource TbtnHoverBg}"/>
                                            <Setter Target="Root.BorderBrush" Value="#8C3FE0C8"/>
                                            <Setter Target="CP.Foreground" Value="{StaticResource CyanBrightBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#20081420"/>
                                            <Setter Target="CP.Foreground" Value="{StaticResource CyanBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ STYLE: Small close / collapse button (X) ════════════════════════ -->
        <Style x:Key="PanelCloseStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="#80081E2A"/>
            <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
            <Setter Property="BorderBrush" Value="#333FE0C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.BackgroundTransition><BrushTransition Duration="0:0:0.14"/></Border.BackgroundTransition>
                            <ContentPresenter x:Name="CP"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#2DFF6F6B"/>
                                            <Setter Target="Root.BorderBrush" Value="#80FF6F6B"/>
                                            <Setter Target="CP.Foreground" Value="White"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#44FF6F6B"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ STYLE: Slider (zoom) ═════════════════════════════════════════════ -->
        <Style x:Key="ZoomSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Minimum" Value="10"/>
            <Setter Property="Maximum" Value="400"/>
            <Setter Property="Value" Value="100"/>
        </Style>

        <!-- ═══ STYLE: Reel thumbnail tile (checked = current image) ═════════════ -->
        <Style x:Key="ReelThumbStyle" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="#73041228"/>
            <Setter Property="BorderBrush" Value="#2E3FE0C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Border.BackgroundTransition><BrushTransition Duration="0:0:0.16"/></Border.BackgroundTransition>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            <VisualStateManager.VisualStateGroups>
                                <!-- One group on purpose — see TbtnGoldStyle: WinUI's ToggleButton
                                     never drives a separate "CheckStates" group. -->
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.BorderBrush" Value="#733FE0C8"/>
                                            <Setter Target="Root.Background" Value="#8C0A2A3A"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#20081420"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.BorderBrush" Value="#CCE9B765"/>
                                            <Setter Target="Root.Background" Value="#8C3A2E12"/>
                                            <Setter Target="Root.BorderThickness" Value="2"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.BorderBrush" Value="#E6E9B765"/>
                                            <Setter Target="Root.Background" Value="#8C3A2E12"/>
                                            <Setter Target="Root.BorderThickness" Value="2"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.BorderBrush" Value="#CCE9B765"/>
                                            <Setter Target="Root.Background" Value="#20081420"/>
                                            <Setter Target="Root.BorderThickness" Value="2"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ STYLE: Library table row (transparent, cyan hover) ══════════════ -->
        <Style x:Key="LibRowStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Border.BackgroundTransition><BrushTransition Duration="0:0:0.12"/></Border.BackgroundTransition>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#8C0A2A3A"/>
                                            <Setter Target="Root.BorderBrush" Value="#473FE0C8"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#20081420"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ STYLE: Library thumbnail tile ═══════════════════════════════════ -->
        <Style x:Key="LibTileStyle" TargetType="Button">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="#73041228"/>
            <Setter Property="BorderBrush" Value="#2E3FE0C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Border.BackgroundTransition><BrushTransition Duration="0:0:0.16"/></Border.BackgroundTransition>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.BorderBrush" Value="#733FE0C8"/>
                                            <Setter Target="Root.Background" Value="#8C0A2A3A"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#20081420"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="56"/>   <!-- Title bar -->
            <RowDefinition Height="*"/>                         <!-- Body -->
            <RowDefinition x:Name="ToolbarRow" Height="74"/>    <!-- Toolbar -->
        </Grid.RowDefinitions>

        <!-- Top cyan accent line -->
        <Rectangle Grid.Row="0" VerticalAlignment="Top" Height="1" Opacity="0.55">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#5AF2DD" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ═══ TITLE BAR ═══════════════════════════════════════════════════════ -->
        <Grid x:Name="TitleBarArea" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Drag region (entire title bar, interactive children intercept input) -->
            <Border x:Name="TitleBarDragArea"
                    Grid.ColumnSpan="2"
                    Background="Transparent"
                    IsHitTestVisible="True"/>

            <!-- LEFT: Brand + Menu -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Spacing="0" Margin="14,0,0,0">

                <!-- Emblem canvas -->
                <Canvas Width="40" Height="40" Margin="0,0,11,0">
                    <!-- Outer circle -->
                    <Ellipse Width="42" Height="42" Canvas.Left="-1" Canvas.Top="-1"
                             Stroke="#3FE0C8" StrokeThickness="1.5" Fill="Transparent"/>
                    <!-- Inner circle -->
                    <Ellipse Width="30" Height="30" Canvas.Left="5" Canvas.Top="5"
                             Stroke="#3FE0C8" StrokeThickness="1" Opacity="0.55" Fill="Transparent"/>
                    <!-- Main wave -->
                    <Path Data="M3 27 C8 27 8 22 14 22 S20 27 26 27 S32 22 38 22"
                          Stroke="#5AF2DD" StrokeThickness="1.6"
                          StrokeEndLineCap="Round" StrokeStartLineCap="Round" Fill="Transparent"/>
                    <!-- Secondary wave -->
                    <Path Data="M6 20 C11 20 11 16 16 16 S21 20 26 20"
                          Stroke="#3FE0C8" StrokeThickness="1" Opacity="0.5" Fill="Transparent"/>
                    <!-- Center vertical line -->
                    <Line X1="20" Y1="2" X2="20" Y2="38" Stroke="#3FE0C8" StrokeThickness="0.7" Opacity="0.45"/>
                    <!-- Gold orbit ring -->
                    <Ellipse Width="12" Height="12" Canvas.Left="14" Canvas.Top="14"
                             Stroke="#E9B765" StrokeThickness="0.8" Opacity="0.7" Fill="Transparent"/>
                    <!-- Pulsing gold dot -->
                    <Ellipse x:Name="EmblemGoldDot" Width="6" Height="6"
                             Canvas.Left="17" Canvas.Top="17" Fill="#E9B765"/>
                </Canvas>

                <!-- Brand text -->
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <TextBlock Text="TALAY"
                                   FontFamily="Georgia" FontSize="21" FontWeight="Bold"
                                   CharacterSpacing="238" Foreground="#DBF7F1"
                                   VerticalAlignment="Center"/>
                        <Border Background="#1A3FE0C8" BorderBrush="#4D3FE0C8"
                                BorderThickness="1" CornerRadius="6"
                                Padding="7,2" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.1" FontFamily="Consolas" FontSize="10"
                                       CharacterSpacing="100" Foreground="#5AF2DD"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Uid="BrandSubtitle" Text="WATER GOD · IMAGE VIEWER"
                               FontFamily="Segoe UI" FontSize="8" CharacterSpacing="300"
                               Foreground="{StaticResource DimBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Separator -->
                <Rectangle Width="1" Height="30" Margin="10,0" Opacity="0.2">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#3FE0C8" Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Menu bar -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                    <!-- File menu -->
                    <Button x:Uid="MenuFile" Style="{StaticResource MenuBtnStyle}">
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem x:Uid="MenuFileOpen" Text="Open" Click="OnMenuFileOpen">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED25;" FontFamily="Segoe MDL2 Assets"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="MenuFileConvert" Text="Convert" Click="OnMenuFileConvert">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AB;" FontFamily="Segoe MDL2 Assets"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutSubItem x:Name="FileRecentSubMenu" x:Uid="MenuFileRecent" Text="Recent Files">
                                    <MenuFlyoutItem x:Uid="MenuFileRecentEmpty" Text="(No files yet)" IsEnabled="False"/>
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Uid="MenuFileImportLibrary" Text="Import Library" Click="OnMenuFileImportLibrary"/>
                                <MenuFlyoutItem x:Uid="MenuFileExportLibrary" Text="Export Library" Click="OnMenuFileExportLibrary"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Uid="MenuFileShare" Text="Share" Click="OnMenuFileShare"/>
                                <MenuFlyoutItem x:Uid="MenuFilePrint" Text="Print" Click="OnMenuFilePrint"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Uid="MenuFileExit" Text="Exit" Click="OnMenuFileExit"/>
                            </MenuFlyout>
                        </Button.Flyout>
                        File
                    </Button>

                    <!-- Effects menu: read-only view effects (tone | colour | light | detail)
                         + reset to the original. Each radio's Tag names its EffectKind;
                         one handler routes them all. -->
                    <Button x:Uid="MenuEffects" Style="{StaticResource MenuBtnStyle}">
                        <Button.Flyout>
                            <MenuFlyout x:Name="EffectsFlyout" Placement="Bottom">
                                <RadioMenuFlyoutItem x:Uid="MenuEffectGrayscale" Text="Grayscale" Tag="Grayscale" GroupName="ViewEffect" Click="OnMenuEffectPicked"/>
                                <RadioMenuFlyoutItem x:Uid="MenuEffectSepia" Text="Sepia" Tag="Sepia" GroupName="ViewEffect" Click="OnMenuEffectPicked"/>
                                <RadioMenuFlyoutItem x:Uid="MenuEffectInvert" Text="Invert" Tag="Invert" GroupName="ViewEffect" Click="OnMenuEffectPicked"/>
                                <MenuFlyoutSeparator/>
                                <RadioMenuFlyoutItem x:Uid="MenuEffectWarm" Text="Warm" Tag="Warm" GroupName="ViewEffect" Click="OnMenuEffectPicked"/>
                                <RadioMenuFlyoutItem x:Uid="MenuEffectCool" Text="Cool" Tag="Cool" GroupName="ViewEffect" Click="OnMenuEffectPicked"/>
                                <RadioMenuFlyoutItem x:Uid="MenuEffectVibrant" Text="Vibrant" Tag="Vibrant" GroupName="ViewEffect" Click="OnMenuEffectPicked"/>
                                <RadioMenuFlyoutItem x:Uid="MenuEffectMuted" Text="Muted" Tag="Muted" GroupName="ViewEffect" Click="OnMenuEffectPicked"/>
                                <MenuFlyoutSeparator/>
                                <RadioMenuFlyoutItem x:Uid="MenuEffectBrighten" Text="Brighten" Tag="Brighten" GroupName="ViewEffect" Click="OnMenuEffectPicked"/>
                                <RadioMenuFlyoutItem x:Uid="MenuEffectDarken" Text="Darken" Tag="Darken" GroupName="ViewEffect" Click="OnMenuEffectPicked"/>
                                <MenuFlyoutSeparator/>
                                <RadioMenuFlyoutItem x:Uid="MenuEffectSharpen" Text="Sharpen" Tag="Sharpen" GroupName="ViewEffect" Click="OnMenuEffectPicked"/>
                                <RadioMenuFlyoutItem x:Uid="MenuEffectSoften" Text="Soften" Tag="Soften" GroupName="ViewEffect" Click="OnMenuEffectPicked"/>
                                <RadioMenuFlyoutItem x:Uid="MenuEffectVignette" Text="Vignette" Tag="Vignette" GroupName="ViewEffect" Click="OnMenuEffectPicked"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Uid="MenuEffectSaveAs" Text="Save As" Click="OnMenuEffectSaveAs">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE792;" FontFamily="Segoe MDL2 Assets"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="MenuEffectReset" Text="Reset to Original" Click="OnMenuEffectReset">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" FontFamily="Segoe MDL2 Assets"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        Effects
                    </Button>

                    <!-- Settings menu: Options opens the options window; Reset All
                         Settings restores every preference to its defaults. -->
                    <Button x:Uid="MenuSettings" Style="{StaticResource MenuBtnStyle}">
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem x:Uid="MenuSettingsOptions" Text="Options" Click="OnMenuOptionsClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Uid="MenuSettingsResetAll" Text="Reset All Settings" Click="OnMenuSettingsResetAll">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" FontFamily="Segoe MDL2 Assets"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        Settings
                    </Button>

                    <!-- Help menu -->
                    <Button x:Uid="MenuHelp" Style="{StaticResource MenuBtnStyle}">
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem x:Uid="MenuHelpGuide" Text="Guide" Click="OnMenuHelpGuide"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Uid="MenuHelpSourceCode" Text="Source Code" Click="OnMenuHelpSourceCode"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Uid="MenuHelpAbout" Text="About" Click="OnMenuHelpAbout"/>
                            </MenuFlyout>
                        </Button.Flyout>
                        Help
                    </Button>

                </StackPanel>
            </StackPanel>

            <!-- RIGHT: Window controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" Margin="0,0,14,0">
                <Button x:Uid="MinimizeBtn" Style="{StaticResource WinCtrlStyle}" Click="OnMinimizeClick" ToolTipService.ToolTip="Minimize">
                    <FontIcon Glyph="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Uid="MaximizeBtn" Style="{StaticResource WinCtrlStyle}" Click="OnMaximizeClick" ToolTipService.ToolTip="Maximize">
                    <FontIcon x:Name="MaximizeIcon" Glyph="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Uid="CloseBtn" Style="{StaticResource WinCtrlCloseStyle}" Click="OnCloseClick" ToolTipService.ToolTip="Close">
                    <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </StackPanel>

            <!-- Title bar bottom seam -->
            <Rectangle Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1" Opacity="0.3">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#3FE0C8" Offset="0.3"/>
                        <GradientStop Color="#5AF2DD" Offset="0.5"/>
                        <GradientStop Color="#3FE0C8" Offset="0.7"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- ═══ BODY ═════════════════════════════════════════════════════════════ -->
        <Grid x:Name="BodyGrid" Grid.Row="1" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ─── VIEWPORT ──────────────────────────────────────────────────── -->
            <Grid x:Name="ViewportGrid" Grid.Column="0"
                  SizeChanged="OnViewportSizeChanged"
                  Margin="0,0,12,0">

                <!-- Main render surface: Direct2D paints frames into a WriteableBitmap
                     shown here. The presenter pins the element's Width/Height to the
                     bitmap's pixel size and the Canvas measures it unconstrained —
                     any other panel would layout-clip an image bigger than the slot.
                     The viewport transform centres, scales and pans the element;
                     ViewportGrid's clip swallows whatever overflows. -->
                <Border x:Name="RenderBorder"
                        CornerRadius="{StaticResource PanelRadius}"
                        Background="Black"
                        BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1">
                    <Canvas>
                        <Image x:Name="RenderImage" Stretch="Uniform"/>
                    </Canvas>
                </Border>

                <!-- Placeholder (shown until an image is opened) -->
                <TextBlock x:Name="ViewportPlaceholder" x:Uid="ViewportHint"
                           Text="Use  File › Open  to open an image"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#25BFE6E2" FontFamily="Consolas" FontSize="13"
                           CharacterSpacing="60" IsHitTestVisible="False"/>

                <!-- Corner brackets -->
                <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="7" BorderBrush="#FF3FE0C8" BorderThickness="2,2,0,0"
                        IsHitTestVisible="False"/>
                <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="7" BorderBrush="#FF3FE0C8" BorderThickness="0,2,2,0"
                        IsHitTestVisible="False"/>
                <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="7" BorderBrush="#FF3FE0C8" BorderThickness="2,0,0,2"
                        IsHitTestVisible="False"/>
                <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="7" BorderBrush="#FF3FE0C8" BorderThickness="0,0,2,2"
                        IsHitTestVisible="False"/>

                <!-- HUD top-left: filename + index -->
                <Border x:Name="HudTopLeft"
                        Visibility="Collapsed"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18"
                        Background="#80030C18" BorderBrush="#383FE0C8" BorderThickness="1"
                        CornerRadius="{StaticResource HudRadius}" Padding="10,6"
                        IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="6" Height="6" Fill="#5AF2DD">
                            <Ellipse.RenderTransform>
                                <ScaleTransform/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock x:Name="HudFilename" Text="—"
                                   FontFamily="Segoe UI" FontSize="10" CharacterSpacing="200"
                                   Foreground="#5AF2DD"/>
                        <TextBlock Text="·" Foreground="#6F9AA3" FontSize="10"/>
                        <TextBlock x:Name="HudIndex" Text="— / —"
                                   FontFamily="Consolas" FontSize="10" Foreground="#5AF2DD"/>
                    </StackPanel>
                </Border>

                <!-- HUD top-right: format info -->
                <Border x:Name="HudTopRight"
                        Visibility="Collapsed"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18"
                        Background="#80030C18" BorderBrush="#383FE0C8" BorderThickness="1"
                        CornerRadius="{StaticResource HudRadius}" Padding="10,6"
                        IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="HudFormat" Text="—"
                                   FontFamily="Consolas" FontSize="10" Foreground="#5AF2DD"/>
                        <TextBlock Text="·" Foreground="#6F9AA3" FontSize="10"/>
                        <TextBlock x:Name="HudDimensions" Text="—"
                                   FontFamily="Consolas" FontSize="10" Foreground="#5AF2DD"/>
                    </StackPanel>
                </Border>

                <!-- HUD bottom-left: date -->
                <Border x:Name="HudBottomLeft"
                        Visibility="Collapsed"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18"
                        Background="#80030C18" BorderBrush="#38E9B765" BorderThickness="1"
                        CornerRadius="{StaticResource HudRadius}" Padding="10,6"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="HudDate" Text="—"
                               FontFamily="Consolas" FontSize="10" Foreground="#E9B765"/>
                </Border>

                <!-- Fullscreen exit button -->
                <Button x:Name="FsExitBtn"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18"
                        Visibility="Collapsed"
                        Click="OnFsExitClick"
                        Background="#99030C18" Foreground="#5AF2DD"
                        BorderBrush="#593FE0C8" BorderThickness="1"
                        CornerRadius="8" Padding="13,9">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="FsExitCaption" Text="EXIT FULLSCREEN" FontFamily="Segoe UI"
                                   FontSize="11" CharacterSpacing="150"/>
                        <FontIcon Glyph="&#xE73F;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </StackPanel>
                </Button>

                <!-- ─── IMAGE LIBRARY PANEL (slides in from left) ────────────── -->
                <Border x:Name="LibraryPanel"
                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Width="880" MaxWidth="880"
                        Padding="34,0,0,0"
                        Background="#EE040E1C"
                        BorderBrush="#593FE0C8" BorderThickness="0,0,1,0"
                        CornerRadius="12,0,0,12">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="LibPanelTranslate" X="-883"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Library header -->
                        <Grid Grid.Row="0" Padding="16,14" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="12" Grid.Column="0"
                                        VerticalAlignment="Center">
                                <TextBlock x:Uid="LibTitle" Text="IMAGE LIBRARY"
                                           FontFamily="Georgia" FontSize="15" CharacterSpacing="300"
                                           Foreground="{StaticResource CyanBrightBrush}"/>
                                <TextBlock x:Name="LibItemCount" x:Uid="LibItemsLabel" Text="0 items"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource DimBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Uid="LibCloseBtn" Grid.Column="1" Style="{StaticResource PanelCloseStyle}"
                                    Click="OnLibCloseClick" ToolTipService.ToolTip="Close">
                                <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                            </Button>
                        </Grid>
                        <Rectangle Grid.Row="0" VerticalAlignment="Bottom" Height="1">
                            <Rectangle.Fill>
                                <SolidColorBrush Color="#263FE0C8"/>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Library body: filters + results -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="248"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Filters sidebar -->
                            <ScrollViewer Grid.Column="0"
                                          BorderBrush="#1A3FE0C8" BorderThickness="0,0,1,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Padding="14" Spacing="16">
                                    <TextBlock x:Uid="LibFilters" Text="FILTERS"
                                               FontFamily="Segoe UI" FontSize="11" CharacterSpacing="300"
                                               Foreground="{StaticResource CyanBrush}"/>
                                    <!-- Name search -->
                                    <StackPanel Spacing="7">
                                        <TextBlock x:Uid="LibFilterNameLabel" Text="NAME" FontFamily="Segoe UI" FontSize="9"
                                                   CharacterSpacing="160" Foreground="{StaticResource DimBrush}"/>
                                        <TextBox x:Name="LibFilterName" x:Uid="LibFilterNameBox" PlaceholderText="search by name..."
                                                 Background="#99040E1C" Foreground="{StaticResource FoamBrush}"
                                                 BorderBrush="#2E3FE0C8" BorderThickness="1"
                                                 CornerRadius="7" Padding="10,8" FontFamily="Consolas" FontSize="12"/>
                                    </StackPanel>
                                    <!-- Format filter: one checkbox per format found in the library -->
                                    <StackPanel Spacing="7">
                                        <TextBlock x:Uid="LibFilterFormatLabel" Text="FORMAT" FontFamily="Segoe UI" FontSize="9"
                                                   CharacterSpacing="160" Foreground="{StaticResource DimBrush}"/>
                                        <DropDownButton x:Name="LibFormatDropDown"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        Background="#99040E1C" Foreground="{StaticResource FoamBrush}"
                                                        BorderBrush="#2E3FE0C8" BorderThickness="1"
                                                        CornerRadius="7" Padding="10,7" FontFamily="Consolas" FontSize="12">
                                            <TextBlock x:Name="LibFormatSummary" Text="—"/>
                                            <DropDownButton.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                    <StackPanel x:Name="LibFormatList" MinWidth="160" Spacing="2"/>
                                                </Flyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                    </StackPanel>
                                    <!-- Date range -->
                                    <StackPanel Spacing="7">
                                        <TextBlock x:Uid="LibFilterDateLabel" Text="DATE" FontFamily="Segoe UI" FontSize="9"
                                                   CharacterSpacing="160" Foreground="{StaticResource DimBrush}"/>
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Uid="LibFilterDateFromLabel" Text="START" FontFamily="Segoe UI" FontSize="8"
                                                       CharacterSpacing="140" Foreground="{StaticResource DimBrush}"/>
                                            <CalendarDatePicker x:Name="LibFilterDateFrom"
                                                                HorizontalAlignment="Stretch"
                                                                Background="#99040E1C"
                                                                BorderBrush="#2E3FE0C8"/>
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Uid="LibFilterDateToLabel" Text="END" FontFamily="Segoe UI" FontSize="8"
                                                       CharacterSpacing="140" Foreground="{StaticResource DimBrush}"/>
                                            <CalendarDatePicker x:Name="LibFilterDateTo"
                                                                HorizontalAlignment="Stretch"
                                                                Background="#99040E1C"
                                                                BorderBrush="#2E3FE0C8"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Size range -->
                                    <StackPanel Spacing="7">
                                        <TextBlock x:Uid="LibFilterSizeLabel" Text="SIZE (KB)" FontFamily="Segoe UI" FontSize="9"
                                                   CharacterSpacing="160" Foreground="{StaticResource DimBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <NumberBox x:Name="LibFilterSizeMin" x:Uid="LibFilterSizeMinBox" PlaceholderText="min"
                                                       Width="92" Background="#99040E1C"
                                                       Foreground="{StaticResource FoamBrush}"
                                                       BorderBrush="#2E3FE0C8" FontFamily="Consolas"/>
                                            <TextBlock Text="—" Foreground="{StaticResource DimBrush}"
                                                       VerticalAlignment="Center"/>
                                            <NumberBox x:Name="LibFilterSizeMax" x:Uid="LibFilterSizeMaxBox" PlaceholderText="max"
                                                       Width="92" Background="#99040E1C"
                                                       Foreground="{StaticResource FoamBrush}"
                                                       BorderBrush="#2E3FE0C8" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Dimension ranges (px) -->
                                    <StackPanel Spacing="7">
                                        <TextBlock x:Uid="LibFilterDimLabel" Text="DIMENSIONS (PX)" FontFamily="Segoe UI" FontSize="9"
                                                   CharacterSpacing="160" Foreground="{StaticResource DimBrush}"/>
                                        <TextBlock x:Uid="LibFilterWidthLabel" Text="WIDTH" FontFamily="Segoe UI" FontSize="8"
                                                   CharacterSpacing="140" Foreground="{StaticResource DimBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <NumberBox x:Name="LibFilterWidthMin" x:Uid="LibFilterWidthMinBox" PlaceholderText="min"
                                                       Width="92" Background="#99040E1C"
                                                       Foreground="{StaticResource FoamBrush}"
                                                       BorderBrush="#2E3FE0C8" FontFamily="Consolas"/>
                                            <TextBlock Text="—" Foreground="{StaticResource DimBrush}"
                                                       VerticalAlignment="Center"/>
                                            <NumberBox x:Name="LibFilterWidthMax" x:Uid="LibFilterWidthMaxBox" PlaceholderText="max"
                                                       Width="92" Background="#99040E1C"
                                                       Foreground="{StaticResource FoamBrush}"
                                                       BorderBrush="#2E3FE0C8" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <TextBlock x:Uid="LibFilterHeightLabel" Text="HEIGHT" FontFamily="Segoe UI" FontSize="8"
                                                   CharacterSpacing="140" Foreground="{StaticResource DimBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <NumberBox x:Name="LibFilterHeightMin" x:Uid="LibFilterHeightMinBox" PlaceholderText="min"
                                                       Width="92" Background="#99040E1C"
                                                       Foreground="{StaticResource FoamBrush}"
                                                       BorderBrush="#2E3FE0C8" FontFamily="Consolas"/>
                                            <TextBlock Text="—" Foreground="{StaticResource DimBrush}"
                                                       VerticalAlignment="Center"/>
                                            <NumberBox x:Name="LibFilterHeightMax" x:Uid="LibFilterHeightMaxBox" PlaceholderText="max"
                                                       Width="92" Background="#99040E1C"
                                                       Foreground="{StaticResource FoamBrush}"
                                                       BorderBrush="#2E3FE0C8" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Kind: still / animated -->
                                    <StackPanel Spacing="7">
                                        <TextBlock x:Uid="LibFilterKindLabel" Text="TYPE" FontFamily="Segoe UI" FontSize="9"
                                                   CharacterSpacing="160" Foreground="{StaticResource DimBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <CheckBox x:Name="LibFilterStills" x:Uid="LibFilterStillsCheck" Content="Still"
                                                      IsChecked="True" MinWidth="0"/>
                                            <CheckBox x:Name="LibFilterAnimated" x:Uid="LibFilterAnimatedCheck" Content="Animated"
                                                      IsChecked="True" MinWidth="0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Source folder -->
                                    <StackPanel Spacing="7">
                                        <TextBlock x:Uid="LibFilterFolderLabel" Text="FOLDER" FontFamily="Segoe UI" FontSize="9"
                                                   CharacterSpacing="160" Foreground="{StaticResource DimBrush}"/>
                                        <ComboBox x:Name="LibFilterFolder"
                                                  HorizontalAlignment="Stretch"
                                                  Background="#99040E1C" Foreground="{StaticResource FoamBrush}"
                                                  BorderBrush="#2E3FE0C8" BorderThickness="1"
                                                  CornerRadius="7" FontFamily="Consolas" FontSize="12"/>
                                    </StackPanel>
                                    <!-- Favorites only -->
                                    <CheckBox x:Name="LibFilterFavorite" x:Uid="LibFilterFavoriteCheck" Content="Favorites only"
                                              MinWidth="0"/>
                                    <!-- Reset button -->
                                    <Button x:Uid="LibResetBtn" HorizontalAlignment="Stretch"
                                            Click="OnLibResetFilters"
                                            Background="#66081E2A"
                                            Foreground="{StaticResource CyanBrush}"
                                            BorderBrush="#333FE0C8" BorderThickness="1"
                                            CornerRadius="8" Padding="9"
                                            FontFamily="Segoe UI" FontSize="11"
                                            CharacterSpacing="150">
                                        Reset Filters
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Results area -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- Results toolbar -->
                                <Grid Grid.Row="0" Padding="14,12" Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LibResultCount" x:Uid="LibResultLabel" Text="0 results"
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource CyanBrightBrush}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                        <ComboBox x:Name="LibDisplayMode"
                                                  Width="120"
                                                  Background="#99040E1C" Foreground="{StaticResource FoamBrush}"
                                                  BorderBrush="#2E3FE0C8" FontFamily="Consolas" FontSize="12">
                                            <ComboBoxItem x:Uid="LibDisplayThumb" Content="Thumbnail" IsSelected="True"/>
                                            <ComboBoxItem x:Uid="LibDisplayTable" Content="Table"/>
                                        </ComboBox>
                                        <ComboBox x:Name="LibSortMode"
                                                  Width="140"
                                                  Background="#99040E1C" Foreground="{StaticResource FoamBrush}"
                                                  BorderBrush="#2E3FE0C8" FontFamily="Consolas" FontSize="12">
                                            <ComboBoxItem x:Uid="LibSortDate" Content="By Date" IsSelected="True"/>
                                            <ComboBoxItem x:Uid="LibSortName" Content="By Name"/>
                                            <ComboBoxItem x:Uid="LibSortFormat" Content="By Format"/>
                                            <ComboBoxItem x:Uid="LibSortSize" Content="By Size"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <Rectangle Grid.Row="0" VerticalAlignment="Bottom" Height="1">
                                    <Rectangle.Fill><SolidColorBrush Color="#1E3FE0C8"/></Rectangle.Fill>
                                </Rectangle>
                                <!-- Results content: table view + thumbnail view + empty state -->
                                <Grid Grid.Row="1">
                                    <Grid x:Name="LibTableView" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <!-- Column headers (widths mirror the code-built rows) -->
                                        <Grid Grid.Row="0" Padding="22,10,24,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="104"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="96"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" x:Uid="LibColName" Text="NAME"
                                                       FontFamily="Segoe UI" FontSize="9" CharacterSpacing="160"
                                                       Foreground="{StaticResource DimBrush}"/>
                                            <TextBlock Grid.Column="2" x:Uid="LibColFormat" Text="FORMAT"
                                                       FontFamily="Segoe UI" FontSize="9" CharacterSpacing="160"
                                                       Foreground="{StaticResource DimBrush}"/>
                                            <TextBlock Grid.Column="3" x:Uid="LibColDims" Text="DIMENSIONS"
                                                       FontFamily="Segoe UI" FontSize="9" CharacterSpacing="160"
                                                       Foreground="{StaticResource DimBrush}"/>
                                            <TextBlock Grid.Column="4" x:Uid="LibColSize" Text="SIZE"
                                                       FontFamily="Segoe UI" FontSize="9" CharacterSpacing="160"
                                                       Foreground="{StaticResource DimBrush}"/>
                                            <TextBlock Grid.Column="5" x:Uid="LibColDate" Text="DATE"
                                                       FontFamily="Segoe UI" FontSize="9" CharacterSpacing="160"
                                                       Foreground="{StaticResource DimBrush}"/>
                                        </Grid>
                                        <Rectangle Grid.Row="0" VerticalAlignment="Bottom" Height="1">
                                            <Rectangle.Fill><SolidColorBrush Color="#143FE0C8"/></Rectangle.Fill>
                                        </Rectangle>
                                        <ScrollViewer Grid.Row="1"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="LibTableRows" Padding="14,8" Spacing="2"/>
                                        </ScrollViewer>
                                    </Grid>
                                    <GridView x:Name="LibThumbGrid"
                                              SelectionMode="None" IsItemClickEnabled="False"
                                              Padding="14,10"/>
                                    <TextBlock x:Name="LibEmptyLabel" x:Uid="LibResultsPlaceholder"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="No matching images"
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="#406F9AA3" Visibility="Collapsed"/>
                                </Grid>
                                <!-- Pager bar (wired in code by the library panel) -->
                                <Rectangle Grid.Row="2" VerticalAlignment="Top" Height="1">
                                    <Rectangle.Fill><SolidColorBrush Color="#1E3FE0C8"/></Rectangle.Fill>
                                </Rectangle>
                                <Grid Grid.Row="2" Padding="14,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Items per page; values mirror k_pageSizes in OLibraryPanel.cpp -->
                                    <ComboBox x:Name="LibPageSize" x:Uid="LibPageSizeBox"
                                              Width="80"
                                              Background="#99040E1C" Foreground="{StaticResource FoamBrush}"
                                              BorderBrush="#2E3FE0C8" FontFamily="Consolas" FontSize="12">
                                        <ComboBoxItem Content="25"/>
                                        <ComboBoxItem Content="50" IsSelected="True"/>
                                        <ComboBoxItem Content="100"/>
                                        <ComboBoxItem Content="200"/>
                                    </ComboBox>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                                                VerticalAlignment="Center">
                                        <Button x:Name="LibPagePrev" x:Uid="LibPagePrevBtn"
                                                Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                Padding="9,5"
                                                Background="#99040E1C" Foreground="{StaticResource FoamBrush}"
                                                BorderBrush="#2E3FE0C8"/>
                                        <TextBlock x:Name="LibPageLabel" Text="1 / 1"
                                                   FontFamily="Consolas" FontSize="12"
                                                   Foreground="{StaticResource GoldBrush}"
                                                   VerticalAlignment="Center" MinWidth="56"
                                                   TextAlignment="Center"/>
                                        <Button x:Name="LibPageNext" x:Uid="LibPageNextBtn"
                                                Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                Padding="9,5"
                                                Background="#99040E1C" Foreground="{StaticResource FoamBrush}"
                                                BorderBrush="#2E3FE0C8"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ─── LIBRARY HANDLE (always visible, left edge) ───────────── -->
                <Button x:Name="LibraryHandle" x:Uid="LibHandleBtn"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Click="OnLibHandleClick"
                        Background="#B3061A26" Foreground="#5AF2DD"
                        BorderBrush="#4D3FE0C8" BorderThickness="0,1,1,1"
                        CornerRadius="0,10,10,0" Padding="7,20"
                        ToolTipService.ToolTip="Library Panel">
                    <StackPanel Orientation="Vertical" Spacing="10" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="13">
                            <FontIcon.RenderTransform>
                                <RotateTransform x:Name="LibHandleChevronRotate" Angle="0" CenterX="6.5" CenterY="6.5"/>
                            </FontIcon.RenderTransform>
                        </FontIcon>
                        <!-- Vertical label: one glyph per line, localized (KİTAPLIK / LIBRARY) -->
                        <TextBlock x:Uid="LibHandleLabel" Text="L&#x0A;I&#x0A;B&#x0A;R&#x0A;A&#x0A;R&#x0A;Y"
                                   FontFamily="Segoe UI" FontSize="9" CharacterSpacing="0" Foreground="#5AF2DD"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   LineHeight="13" LineStackingStrategy="BlockLineHeight"/>
                    </StackPanel>
                </Button>

            </Grid>
            <!-- ─── end ViewportGrid ─────────────────────────────────────────── -->

            <!-- ─── REEL PANEL ────────────────────────────────────────────────── -->
            <Border x:Name="ReelPanel" Grid.Column="1"
                    Width="42"
                    Background="#8C051621"
                    BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1"
                    CornerRadius="0,12,12,0"
                    MinWidth="42">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Reel header — single toggle button, title hides when collapsed -->
                    <Grid Grid.Row="0" Padding="7,13" MinHeight="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ReelTitle" x:Uid="ReelTitleLabel" Text="FOLDER" FontFamily="Georgia" FontSize="12.5"
                                   CharacterSpacing="250" Foreground="{StaticResource CyanBrightBrush}"
                                   VerticalAlignment="Center" Grid.Column="0"
                                   Visibility="Collapsed"/>
                        <Button x:Uid="ReelCollapseBtn" Grid.Column="1" Style="{StaticResource WinCtrlStyle}"
                                Width="26" Height="26"
                                Click="OnReelCollapseClick" ToolTipService.ToolTip="Folder Panel">
                            <FontIcon x:Name="ReelCollapseIcon" Glyph="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                        </Button>
                    </Grid>
                    <Rectangle Grid.Row="0" VerticalAlignment="Bottom" Height="1">
                        <Rectangle.Fill><SolidColorBrush Color="#1E3FE0C8"/></Rectangle.Fill>
                    </Rectangle>

                    <!-- Expanded content -->
                    <ScrollViewer x:Name="ReelContent" Grid.Row="1"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="10">
                        <StackPanel x:Name="ReelThumbs" Spacing="10">
                            <!-- Thumbnails populated from the opened folder at runtime -->
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Pager — bounds how many thumbnails decode at once; hides with the content -->
                    <Grid x:Name="ReelPager" Grid.Row="2" Visibility="Collapsed">
                        <Rectangle VerticalAlignment="Top" Height="1">
                            <Rectangle.Fill><SolidColorBrush Color="#1E3FE0C8"/></Rectangle.Fill>
                        </Rectangle>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,9"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="ReelPagePrev" x:Uid="ReelPagePrevBtn"
                                    Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                    Padding="9,5"
                                    Background="#99040E1C" Foreground="{StaticResource FoamBrush}"
                                    BorderBrush="#2E3FE0C8"/>
                            <TextBlock x:Name="ReelPageLabel" Text="1 / 1"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource GoldBrush}"
                                       VerticalAlignment="Center" MinWidth="56"
                                       TextAlignment="Center"/>
                            <Button x:Name="ReelPageNext" x:Uid="ReelPageNextBtn"
                                    Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                    Padding="9,5"
                                    Background="#99040E1C" Foreground="{StaticResource FoamBrush}"
                                    BorderBrush="#2E3FE0C8"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
        <!-- ─── end Body ────────────────────────────────────────────────────── -->

        <!-- ═══ TOOLBAR ═════════════════════════════════════════════════════════ -->
        <Grid x:Name="ToolbarGrid" Grid.Row="2"
              Background="#CC04101A"
              Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Top seam -->
            <Rectangle Grid.ColumnSpan="3" VerticalAlignment="Top" Height="1" Opacity="0.3">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#3FE0C8" Offset="0.4"/>
                        <GradientStop Color="#3FE0C8" Offset="0.6"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- LEFT CLUSTER -->
            <Grid Grid.Column="0" Margin="14,0,0,0" VerticalAlignment="Center">
                <!-- Cluster background -->
                <Border Background="#73041228" BorderBrush="#1A3FE0C8" BorderThickness="1"
                        CornerRadius="13" Padding="12,8"/>
                <!-- Corner brackets -->
                <Border Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="-1,-1,0,0" BorderBrush="#993FE0C8" BorderThickness="1.5,1.5,0,0"
                        IsHitTestVisible="False"/>
                <Border Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,-1,-1" BorderBrush="#993FE0C8" BorderThickness="0,0,1.5,1.5"
                        IsHitTestVisible="False"/>
                <!-- Buttons row -->
                <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,8">

                    <ToggleButton x:Name="FolderBtn" x:Uid="FolderToolBtn" Style="{StaticResource TbtnCyanStyle}"
                                  Click="OnFolderBtnClick" ToolTipService.ToolTip="Folder Reel Panel">
                        <StackPanel Orientation="Vertical" Spacing="5">
                            <FontIcon Glyph="&#xE8DA;" FontFamily="Segoe MDL2 Assets" FontSize="21"/>
                            <TextBlock x:Uid="FolderBtnCaption" Text="FOLDER" FontFamily="Segoe UI" FontSize="8.5" CharacterSpacing="160"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="FavBtn" x:Uid="FavToolBtn" Style="{StaticResource TbtnGoldStyle}"
                                  Click="OnFavBtnClick" ToolTipService.ToolTip="Favorite">
                        <StackPanel Orientation="Vertical" Spacing="5">
                            <FontIcon Glyph="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="21"/>
                            <TextBlock x:Uid="FavBtnCaption" Text="FAVORITE" FontFamily="Segoe UI" FontSize="8.5" CharacterSpacing="160"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="LibAddBtn" x:Uid="LibAddToolBtn" Style="{StaticResource TbtnGoldStyle}"
                                  Click="OnLibAddBtnClick" ToolTipService.ToolTip="Add to Library">
                        <StackPanel Orientation="Vertical" Spacing="5">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="21"/>
                            <TextBlock x:Uid="LibAddBtnCaption" Text="LIBRARY" FontFamily="Segoe UI" FontSize="8.5" CharacterSpacing="160"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="InfoBtn" x:Uid="InfoToolBtn" Style="{StaticResource TbtnCyanStyle}"
                                  Click="OnInfoBtnClick" ToolTipService.ToolTip="File Info">
                        <StackPanel Orientation="Vertical" Spacing="5">
                            <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="21"/>
                            <TextBlock x:Uid="InfoBtnCaption" Text="INFO" FontFamily="Segoe UI" FontSize="8.5" CharacterSpacing="160"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Divider -->
                    <Rectangle Width="1" Height="34" Margin="2,0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#593FE0C8" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Dimensions chip -->
                    <Border Background="#80061A26" BorderBrush="#233FE0C8" BorderThickness="1"
                            CornerRadius="9" Padding="13,6">
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="ChipDimensionsLabel" Text="DIMENSIONS" FontFamily="Segoe UI" FontSize="8"
                                       CharacterSpacing="160" Foreground="{StaticResource DimBrush}"/>
                            <TextBlock x:Name="ChipDimensions" Text="— × —"
                                       FontFamily="Consolas" FontSize="14"
                                       Foreground="{StaticResource CyanBrightBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Size chip -->
                    <Border Background="#80061A26" BorderBrush="#233FE0C8" BorderThickness="1"
                            CornerRadius="9" Padding="13,6">
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="ChipSizeLabel" Text="SIZE" FontFamily="Segoe UI" FontSize="8"
                                       CharacterSpacing="160" Foreground="{StaticResource DimBrush}"/>
                            <TextBlock x:Name="ChipFileSize" Text="— KB"
                                       FontFamily="Consolas" FontSize="14"
                                       Foreground="{StaticResource CyanBrightBrush}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

            <!-- CENTER WAVE -->
            <Border Grid.Column="1" VerticalAlignment="Center" Height="14" Margin="8,0" Opacity="0.28">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#3FE0C8" Offset="0.25"/>
                        <GradientStop Color="#3FE0C8" Offset="0.75"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- RIGHT CLUSTER -->
            <Grid Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center">
                <Border Background="#73041228" BorderBrush="#1A3FE0C8" BorderThickness="1"
                        CornerRadius="13" Padding="12,8"/>
                <Border Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="-1,-1,0,0" BorderBrush="#993FE0C8" BorderThickness="1.5,1.5,0,0"
                        IsHitTestVisible="False"/>
                <Border Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,-1,-1" BorderBrush="#993FE0C8" BorderThickness="0,0,1.5,1.5"
                        IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,8">

                    <Button x:Uid="RotateBtn" Style="{StaticResource TbtnStyle}" Click="OnRotateBtnClick"
                            ToolTipService.ToolTip="Rotate" Padding="12,7">
                        <StackPanel Orientation="Vertical" Spacing="5">
                            <FontIcon Glyph="&#xE7AD;" FontFamily="Segoe MDL2 Assets" FontSize="21"/>
                            <TextBlock x:Uid="RotateBtnCaption" Text="ROTATE" FontFamily="Segoe UI" FontSize="8.5" CharacterSpacing="160"/>
                        </StackPanel>
                    </Button>

                    <Button x:Uid="ZoomOutBtn" Style="{StaticResource TbtnStyle}" Click="OnZoomOutClick"
                            ToolTipService.ToolTip="Zoom Out" Padding="11,11">
                        <FontIcon Glyph="&#xE1A4;" FontFamily="Segoe MDL2 Assets" FontSize="21"/>
                    </Button>

                    <!-- Zoom control -->
                    <StackPanel Orientation="Vertical" Spacing="6" Width="158" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Uid="ZoomLevelLabel" Text="ZOOM LEVEL"
                                       FontFamily="Segoe UI" FontSize="8.5" CharacterSpacing="180"
                                       Foreground="{StaticResource DimBrush}"/>
                            <TextBlock x:Name="ZoomValueText" Text="100%"
                                       FontFamily="Consolas" FontSize="13"
                                       Foreground="{StaticResource GoldBrightBrush}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="ZoomSlider" Minimum="10" Maximum="400" Value="100"
                                Style="{StaticResource ZoomSliderStyle}"
                                ValueChanged="OnZoomSliderChanged">
                            <Slider.Resources>
                                <Color x:Key="SystemAccentColor">#FF3FE0C8</Color>
                                <Color x:Key="SystemAccentColorDark1">#FF27C2E0</Color>
                                <Color x:Key="SystemAccentColorDark2">#FF1BA8C8</Color>
                                <SolidColorBrush x:Key="SliderThumbBackground" Color="#DBF7F1"/>
                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#5AF2DD"/>
                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#3FE0C8"/>
                            </Slider.Resources>
                        </Slider>
                    </StackPanel>

                    <Button x:Uid="ZoomInBtn" Style="{StaticResource TbtnStyle}" Click="OnZoomInClick"
                            ToolTipService.ToolTip="Zoom In" Padding="11,11">
                        <FontIcon Glyph="&#xE1A3;" FontFamily="Segoe MDL2 Assets" FontSize="21"/>
                    </Button>

                    <ToggleButton x:Name="FsBtn" x:Uid="FsToolBtn" Style="{StaticResource TbtnCyanStyle}"
                                  Click="OnFullscreenBtnClick" ToolTipService.ToolTip="Fullscreen">
                        <StackPanel Orientation="Vertical" Spacing="5">
                            <FontIcon Glyph="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="21"/>
                            <TextBlock x:Uid="FsBtnCaption" Text="FULLSCREEN" FontFamily="Segoe UI" FontSize="8.5" CharacterSpacing="160"/>
                        </StackPanel>
                    </ToggleButton>

                </StackPanel>
            </Grid>

        </Grid>
        <!-- ─── end Toolbar ─────────────────────────────────────────────────── -->

        <!-- ═══ INFO MODAL ══════════════════════════════════════════════════════ -->
        <Grid x:Name="InfoModal"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Canvas.ZIndex="100">
            <!-- Backdrop -->
            <Grid Background="#D9020A12" Tapped="OnInfoModalBackdropClick"/>
            <!-- Modal box centered -->
            <Border MaxWidth="460" MinWidth="360"
                    MaxHeight="640"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#F7071A26"
                    BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Modal corner brackets -->
                    <Border Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="-1" BorderBrush="#993FE0C8" BorderThickness="2,2,0,0"
                            IsHitTestVisible="False"/>
                    <Border Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="-1" BorderBrush="#993FE0C8" BorderThickness="0,2,2,0"
                            IsHitTestVisible="False"/>
                    <Border Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="-1" BorderBrush="#993FE0C8" BorderThickness="2,0,0,2"
                            IsHitTestVisible="False"/>
                    <Border Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="-1" BorderBrush="#993FE0C8" BorderThickness="0,0,2,2"
                            IsHitTestVisible="False"/>

                    <!-- Header -->
                    <Grid Grid.Row="0" Padding="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" Grid.Column="0" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                      Foreground="{StaticResource CyanBrightBrush}"/>
                            <TextBlock x:Uid="InfoModalTitle" Text="FILE INFO"
                                       FontFamily="Georgia" FontSize="14" CharacterSpacing="200"
                                       Foreground="{StaticResource CyanBrightBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PanelCloseStyle}"
                                Click="OnInfoCloseClick">
                            <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                        </Button>
                    </Grid>
                    <Rectangle Grid.Row="0" VerticalAlignment="Bottom" Height="1">
                        <Rectangle.Fill><SolidColorBrush Color="#263FE0C8"/></Rectangle.Fill>
                    </Rectangle>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16">
                            <!-- Preview area: shows the open image (source set from code) -->
                            <Border Height="128" CornerRadius="10" Margin="0,0,0,14"
                                    BorderBrush="#333FE0C8" BorderThickness="1" Background="Black">
                                <Image x:Name="InfoPreview" Stretch="Uniform" Margin="6"/>
                            </Border>

                            <!-- Info rows (values filled from code when image loads) -->
                            <StackPanel>
                                <!-- Row template: key left, value right, separator below -->
                                <Grid Padding="0,9,0,9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="InfoLabelName" Text="FILE NAME" FontFamily="Segoe UI" FontSize="10" CharacterSpacing="120" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="InfoValName" Text="—" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource FoamBrush}" MaxWidth="240" TextWrapping="WrapWholeWords" TextAlignment="Right"/>
                                </Grid>
                                <Rectangle Height="1"><Rectangle.Fill><SolidColorBrush Color="#12DBF7F1"/></Rectangle.Fill></Rectangle>
                                <Grid Padding="0,9,0,9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="InfoLabelFormat" Text="FORMAT" FontFamily="Segoe UI" FontSize="10" CharacterSpacing="120" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="InfoValFormat" Text="—" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource FoamBrush}"/>
                                </Grid>
                                <Rectangle Height="1"><Rectangle.Fill><SolidColorBrush Color="#12DBF7F1"/></Rectangle.Fill></Rectangle>
                                <Grid Padding="0,9,0,9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="InfoLabelDims" Text="DIMENSIONS" FontFamily="Segoe UI" FontSize="10" CharacterSpacing="120" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="InfoValDims" Text="—" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource FoamBrush}"/>
                                </Grid>
                                <Rectangle Height="1"><Rectangle.Fill><SolidColorBrush Color="#12DBF7F1"/></Rectangle.Fill></Rectangle>
                                <Grid Padding="0,9,0,9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="InfoLabelAspect" Text="ASPECT RATIO" FontFamily="Segoe UI" FontSize="10" CharacterSpacing="120" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="InfoValAspect" Text="—" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource FoamBrush}"/>
                                </Grid>
                                <Rectangle Height="1"><Rectangle.Fill><SolidColorBrush Color="#12DBF7F1"/></Rectangle.Fill></Rectangle>
                                <Grid Padding="0,9,0,9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="InfoLabelDepth" Text="COLOR PALETTE" FontFamily="Segoe UI" FontSize="10" CharacterSpacing="120" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="InfoValDepth" Text="—" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource FoamBrush}"/>
                                </Grid>
                                <Rectangle Height="1"><Rectangle.Fill><SolidColorBrush Color="#12DBF7F1"/></Rectangle.Fill></Rectangle>
                                <Grid Padding="0,9,0,9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="InfoLabelProfile" Text="COLOR PROFILE" FontFamily="Segoe UI" FontSize="10" CharacterSpacing="120" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="InfoValProfile" Text="—" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource FoamBrush}"/>
                                </Grid>
                                <Rectangle Height="1"><Rectangle.Fill><SolidColorBrush Color="#12DBF7F1"/></Rectangle.Fill></Rectangle>
                                <Grid Padding="0,9,0,9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="InfoLabelDpi" Text="RESOLUTION" FontFamily="Segoe UI" FontSize="10" CharacterSpacing="120" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="InfoValDpi" Text="—" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource FoamBrush}"/>
                                </Grid>
                                <Rectangle Height="1"><Rectangle.Fill><SolidColorBrush Color="#12DBF7F1"/></Rectangle.Fill></Rectangle>
                                <Grid Padding="0,9,0,9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="InfoLabelSize" Text="SIZE" FontFamily="Segoe UI" FontSize="10" CharacterSpacing="120" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="InfoValSize" Text="—" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource FoamBrush}"/>
                                </Grid>
                                <Rectangle Height="1"><Rectangle.Fill><SolidColorBrush Color="#12DBF7F1"/></Rectangle.Fill></Rectangle>
                                <Grid Padding="0,9,0,9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="InfoLabelCreated" Text="CREATED" FontFamily="Segoe UI" FontSize="10" CharacterSpacing="120" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="InfoValCreated" Text="—" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource FoamBrush}"/>
                                </Grid>
                                <Rectangle Height="1"><Rectangle.Fill><SolidColorBrush Color="#12DBF7F1"/></Rectangle.Fill></Rectangle>
                                <Grid Padding="0,9,0,9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="InfoLabelModified" Text="MODIFIED" FontFamily="Segoe UI" FontSize="10" CharacterSpacing="120" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="InfoValModified" Text="—" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource FoamBrush}"/>
                                </Grid>
                                <Rectangle Height="1"><Rectangle.Fill><SolidColorBrush Color="#12DBF7F1"/></Rectangle.Fill></Rectangle>
                                <Grid Padding="0,9,0,9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="InfoLabelPath" Text="PATH" FontFamily="Segoe UI" FontSize="10" CharacterSpacing="120" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="InfoValPath" Text="—" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource FoamBrush}" MaxWidth="280" TextWrapping="WrapWholeWords" TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ GUIDE MODAL ═════════════════════════════════════════════════════ -->
        <Grid x:Name="GuideModal"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Canvas.ZIndex="100">
            <!-- Backdrop -->
            <Grid Background="#D9020A12" Tapped="OnGuideModalBackdropClick"/>
            <!-- Modal box centered -->
            <Border MaxWidth="540" MinWidth="420"
                    MaxHeight="660"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#F7071A26"
                    BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Modal corner brackets -->
                    <Border Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="-1" BorderBrush="#993FE0C8" BorderThickness="2,2,0,0"
                            IsHitTestVisible="False"/>
                    <Border Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="-1" BorderBrush="#993FE0C8" BorderThickness="0,2,2,0"
                            IsHitTestVisible="False"/>
                    <Border Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="-1" BorderBrush="#993FE0C8" BorderThickness="2,0,0,2"
                            IsHitTestVisible="False"/>
                    <Border Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="-1" BorderBrush="#993FE0C8" BorderThickness="0,0,2,2"
                            IsHitTestVisible="False"/>

                    <!-- Header -->
                    <Grid Grid.Row="0" Padding="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" Grid.Column="0" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                      Foreground="{StaticResource CyanBrightBrush}"/>
                            <TextBlock x:Uid="GuideModalTitle" Text="GUIDE"
                                       FontFamily="Georgia" FontSize="14" CharacterSpacing="200"
                                       Foreground="{StaticResource CyanBrightBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PanelCloseStyle}"
                                Click="OnGuideCloseClick">
                            <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                        </Button>
                    </Grid>
                    <Rectangle Grid.Row="0" VerticalAlignment="Bottom" Height="1">
                        <Rectangle.Fill><SolidColorBrush Color="#263FE0C8"/></Rectangle.Fill>
                    </Rectangle>

                    <!-- Body: one row per feature — icon chip left, title + short text right -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="20,18" Spacing="16">

                            <!-- Open images -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" VerticalAlignment="Top"
                                        Background="#1A3FE0C8" BorderBrush="#4D3FE0C8" BorderThickness="1">
                                    <FontIcon Glyph="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                              Foreground="{StaticResource CyanBrightBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Uid="GuideOpenTitle" Text="OPEN IMAGES"
                                               FontFamily="Segoe UI" FontSize="11" CharacterSpacing="160"
                                               Foreground="{StaticResource GoldBrightBrush}"/>
                                    <TextBlock x:Uid="GuideOpenBody"
                                               Text="Use File › Open, drop a file onto the viewport, or open one from Explorer. Recent picks wait under File › Recent Files."
                                               FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Folder reel -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" VerticalAlignment="Top"
                                        Background="#1A3FE0C8" BorderBrush="#4D3FE0C8" BorderThickness="1">
                                    <FontIcon Glyph="&#xE8DA;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                              Foreground="{StaticResource CyanBrightBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Uid="GuideReelTitle" Text="BROWSE THE FOLDER"
                                               FontFamily="Segoe UI" FontSize="11" CharacterSpacing="160"
                                               Foreground="{StaticResource GoldBrightBrush}"/>
                                    <TextBlock x:Uid="GuideReelBody"
                                               Text="The reel on the right lists the open image's folder page by page. Click a thumbnail to switch images; the arrows change pages."
                                               FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- View controls -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" VerticalAlignment="Top"
                                        Background="#1A3FE0C8" BorderBrush="#4D3FE0C8" BorderThickness="1">
                                    <FontIcon Glyph="&#xE1A3;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                              Foreground="{StaticResource CyanBrightBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Uid="GuideViewTitle" Text="VIEW CONTROLS"
                                               FontFamily="Segoe UI" FontSize="11" CharacterSpacing="160"
                                               Foreground="{StaticResource GoldBrightBrush}"/>
                                    <TextBlock x:Uid="GuideViewBody"
                                               Text="The mouse wheel zooms at the cursor and dragging pans. Rotate, the zoom slider and fullscreen live on the bottom toolbar."
                                               FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Library & favorites -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" VerticalAlignment="Top"
                                        Background="#1A3FE0C8" BorderBrush="#4D3FE0C8" BorderThickness="1">
                                    <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                              Foreground="{StaticResource CyanBrightBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Uid="GuideLibraryTitle" Text="LIBRARY &amp; FAVORITES"
                                               FontFamily="Segoe UI" FontSize="11" CharacterSpacing="160"
                                               Foreground="{StaticResource GoldBrightBrush}"/>
                                    <TextBlock x:Uid="GuideLibraryBody"
                                               Text="The handle on the left edge opens your library. +LIB keeps the open image, the star marks it a favorite, and the panel filters by name, format, size or date."
                                               FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Convert & share -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" VerticalAlignment="Top"
                                        Background="#1A3FE0C8" BorderBrush="#4D3FE0C8" BorderThickness="1">
                                    <FontIcon Glyph="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                              Foreground="{StaticResource CyanBrightBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Uid="GuideConvertTitle" Text="CONVERT &amp; SHARE"
                                               FontFamily="Segoe UI" FontSize="11" CharacterSpacing="160"
                                               Foreground="{StaticResource GoldBrightBrush}"/>
                                    <TextBlock x:Uid="GuideConvertBody"
                                               Text="File › Convert saves the open image in another format — right-clicking images in Explorer and choosing Convert with Talay works too. File › Share copies it to the clipboard; Print puts it on paper."
                                               FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ ABOUT MODAL ═════════════════════════════════════════════════════ -->
        <Grid x:Name="AboutModal"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Canvas.ZIndex="100">
            <!-- Backdrop -->
            <Grid Background="#D9020A12" Tapped="OnAboutModalBackdropClick"/>
            <!-- Modal box centered -->
            <Border MaxWidth="430" MinWidth="380"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#F7071A26"
                    BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Modal corner brackets -->
                    <Border Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="-1" BorderBrush="#993FE0C8" BorderThickness="2,2,0,0"
                            IsHitTestVisible="False"/>
                    <Border Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="-1" BorderBrush="#993FE0C8" BorderThickness="0,2,2,0"
                            IsHitTestVisible="False"/>
                    <Border Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="-1" BorderBrush="#993FE0C8" BorderThickness="2,0,0,2"
                            IsHitTestVisible="False"/>
                    <Border Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="-1" BorderBrush="#993FE0C8" BorderThickness="0,0,2,2"
                            IsHitTestVisible="False"/>

                    <!-- Header -->
                    <Grid Grid.Row="0" Padding="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" Grid.Column="0" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                      Foreground="{StaticResource CyanBrightBrush}"/>
                            <TextBlock x:Uid="AboutModalTitle" Text="ABOUT TALAY"
                                       FontFamily="Georgia" FontSize="14" CharacterSpacing="200"
                                       Foreground="{StaticResource CyanBrightBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PanelCloseStyle}"
                                Click="OnAboutCloseClick">
                            <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                        </Button>
                    </Grid>
                    <Rectangle Grid.Row="0" VerticalAlignment="Bottom" Height="1">
                        <Rectangle.Fill><SolidColorBrush Color="#263FE0C8"/></Rectangle.Fill>
                    </Rectangle>

                    <!-- Body -->
                    <StackPanel Grid.Row="1" Padding="26,24,26,22" Spacing="0" HorizontalAlignment="Center">

                        <!-- Logo: the Talay emblem, scaled up from the title-bar artwork -->
                        <Viewbox Width="88" Height="88" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Canvas Width="40" Height="40">
                                <Ellipse Width="42" Height="42" Canvas.Left="-1" Canvas.Top="-1"
                                         Stroke="#3FE0C8" StrokeThickness="1.5" Fill="Transparent"/>
                                <Ellipse Width="30" Height="30" Canvas.Left="5" Canvas.Top="5"
                                         Stroke="#3FE0C8" StrokeThickness="1" Opacity="0.55" Fill="Transparent"/>
                                <Path Data="M3 27 C8 27 8 22 14 22 S20 27 26 27 S32 22 38 22"
                                      Stroke="#5AF2DD" StrokeThickness="1.6"
                                      StrokeEndLineCap="Round" StrokeStartLineCap="Round" Fill="Transparent"/>
                                <Path Data="M6 20 C11 20 11 16 16 16 S21 20 26 20"
                                      Stroke="#3FE0C8" StrokeThickness="1" Opacity="0.5" Fill="Transparent"/>
                                <Line X1="20" Y1="2" X2="20" Y2="38" Stroke="#3FE0C8" StrokeThickness="0.7" Opacity="0.45"/>
                                <Ellipse Width="12" Height="12" Canvas.Left="14" Canvas.Top="14"
                                         Stroke="#E9B765" StrokeThickness="0.8" Opacity="0.7" Fill="Transparent"/>
                                <Ellipse Width="6" Height="6" Canvas.Left="17" Canvas.Top="17" Fill="#E9B765"/>
                            </Canvas>
                        </Viewbox>

                        <!-- Wordmark + version -->
                        <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                            <TextBlock Text="TALAY"
                                       FontFamily="Georgia" FontSize="24" FontWeight="Bold"
                                       CharacterSpacing="238" Foreground="{StaticResource FoamBrush}"
                                       VerticalAlignment="Center"/>
                            <Border Background="#1A3FE0C8" BorderBrush="#4D3FE0C8"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Text="v1.0.1" FontFamily="Consolas" FontSize="10"
                                           CharacterSpacing="100" Foreground="#5AF2DD"/>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Uid="AboutModalTagline" Text="WATER GOD · IMAGE VIEWER"
                                   FontFamily="Segoe UI" FontSize="9" CharacterSpacing="300"
                                   Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center"
                                   Margin="0,7,0,0"/>

                        <!-- Separator -->
                        <Rectangle Height="1" Margin="0,18,0,16" Opacity="0.4">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#3FE0C8" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <TextBlock x:Uid="AboutModalDescription"
                                   Text="Image viewer and converter for Windows."
                                   FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap"
                                   TextAlignment="Center" Foreground="{StaticResource TextBrush}"/>

                        <!-- Homepage link (opens the default browser) -->
                        <Button Style="{StaticResource MenuBtnStyle}" Click="OnAboutHomepageClick"
                                Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center"
                                Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                <TextBlock Text="www.ankainteractive.com/#talay"
                                           FontFamily="Consolas" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <TextBlock x:Uid="AboutModalCopyright" Text="© 2025 AnkA Interactive"
                                   FontFamily="Segoe UI" FontSize="10" CharacterSpacing="100"
                                   Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center"
                                   Margin="0,14,0,0"/>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
