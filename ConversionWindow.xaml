<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Talay.ConversionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Talay"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Convert Image">

    <!-- ═══ ROOT GRID ══════════════════════════════════════════════════════════ -->
    <Grid x:Name="RootGrid" RequestedTheme="Dark">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0D3344" Offset="0"/>
                <GradientStop Color="#061B2C" Offset="0.45"/>
                <GradientStop Color="#02101A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.Resources>

            <!-- ═══ COLORS / BRUSHES ════════════════════════════════════════════ -->
            <Color x:Key="CyanColor">#3FE0C8</Color>
            <Color x:Key="CyanBrightColor">#5AF2DD</Color>
            <SolidColorBrush x:Key="CyanBrush"       Color="{StaticResource CyanColor}"/>
            <SolidColorBrush x:Key="CyanBrightBrush" Color="{StaticResource CyanBrightColor}"/>
            <SolidColorBrush x:Key="FoamBrush"       Color="#DBF7F1"/>
            <SolidColorBrush x:Key="TextBrush"       Color="#BFE6E2"/>
            <SolidColorBrush x:Key="DimBrush"        Color="#6F9AA3"/>
            <SolidColorBrush x:Key="FieldBgBrush"    Color="#99040E1C"/>
            <SolidColorBrush x:Key="EdgeBrush"       Color="#2E3FE0C8"/>

            <LinearGradientBrush x:Key="BtnNormalBg" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#7F143848" Offset="0"/>
                <GradientStop Color="#7F081E2A" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BtnHoverBg" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#A61C4C5E" Offset="0"/>
                <GradientStop Color="#A60A2634" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PrimaryBg" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#E62A8EA6" Offset="0"/>
                <GradientStop Color="#E60F4150" Offset="1"/>
            </LinearGradientBrush>

            <!-- ═══ STYLE: field caption ════════════════════════════════════════ -->
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="CharacterSpacing" Value="160"/>
                <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <!-- ═══ STYLE: text input ═══════════════════════════════════════════ -->
            <Style x:Key="FieldBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource FieldBgBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource FoamBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <!-- ═══ STYLE: secondary button (Browse / Cancel) ═══════════════════ -->
            <Style x:Key="SecondaryBtnStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BtnNormalBg}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="Padding" Value="14,9"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="CharacterSpacing" Value="80"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <Border.BackgroundTransition><BrushTransition Duration="0:0:0.14"/></Border.BackgroundTransition>
                                <ContentPresenter x:Name="CP" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource BtnHoverBg}"/>
                                                <Setter Target="Root.BorderBrush" Value="#8C3FE0C8"/>
                                                <Setter Target="CP.Foreground" Value="{StaticResource CyanBrightBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#20081420"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══ STYLE: primary button (Convert) ═════════════════════════════ -->
            <Style x:Key="PrimaryBtnStyle" TargetType="Button" BasedOn="{StaticResource SecondaryBtnStyle}">
                <Setter Property="Background" Value="{StaticResource PrimaryBg}"/>
                <Setter Property="Foreground" Value="{StaticResource CyanBrightBrush}"/>
                <Setter Property="BorderBrush" Value="#993FE0C8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- ═══ STYLE: close button (red hover) ═════════════════════════════ -->
            <Style x:Key="CloseBtnStyle" TargetType="Button">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="Background" Value="#66081E2A"/>
                <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
                <Setter Property="BorderBrush" Value="#293FE0C8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <Border.BackgroundTransition><BrushTransition Duration="0:0:0.14"/></Border.BackgroundTransition>
                                <ContentPresenter x:Name="CP" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#2DFF6F6B"/>
                                                <Setter Target="Root.BorderBrush" Value="#99FF6F6B"/>
                                                <Setter Target="CP.Foreground" Value="White"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#44FF6F6B"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>   <!-- Title bar -->
            <RowDefinition Height="*"/>    <!-- Body -->
        </Grid.RowDefinitions>

        <!-- ═══ TITLE BAR ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="TitleBarDragArea" Grid.ColumnSpan="2"
                    Background="Transparent" IsHitTestVisible="True"/>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"
                        VerticalAlignment="Center" Margin="16,0,0,0">
                <FontIcon Glyph="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                          Foreground="{StaticResource CyanBrush}"/>
                <TextBlock x:Uid="ConvTitle" Text="CONVERT IMAGE"
                           FontFamily="Georgia" FontSize="14" CharacterSpacing="260"
                           Foreground="{StaticResource FoamBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <Button x:Name="CloseBtn" x:Uid="ConvCloseBtn" Grid.Column="1" Style="{StaticResource CloseBtnStyle}"
                    Click="OnCloseClick" Margin="0,0,12,0" VerticalAlignment="Center"
                    ToolTipService.ToolTip="Close">
                <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
            </Button>

            <Rectangle Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1" Opacity="0.3">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#5AF2DD" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- ═══ BODY ════════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="1" Margin="22,18,22,20" Spacing="16">

            <!-- Source (filled at runtime: a single path, or "N files" with the
                 full list in the tooltip when a batch arrives from the shell) -->
            <StackPanel>
                <TextBlock x:Uid="ConvSourceLabel" Text="SOURCE" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="SourceBox" Style="{StaticResource FieldBoxStyle}" IsReadOnly="True"/>
            </StackPanel>

            <!-- Format -->
            <StackPanel>
                <TextBlock x:Uid="ConvFormatLabel" Text="FORMAT TO CONVERT" Style="{StaticResource FieldLabelStyle}"/>
                <!-- Items are filled at runtime (ConversionWindow::BuildFormatList) from the
                     writable subset of the viewer's supported formats. -->
                <ComboBox x:Name="FormatBox" HorizontalAlignment="Stretch"
                          Background="{StaticResource FieldBgBrush}" Foreground="{StaticResource FoamBrush}"
                          BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1"
                          CornerRadius="7" FontFamily="Consolas" FontSize="13"/>
            </StackPanel>

            <!-- New image name -->
            <StackPanel>
                <TextBlock x:Uid="ConvNameLabel" Text="NEW IMAGE NAME" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource FieldBoxStyle}"/>
            </StackPanel>

            <!-- Output directory -->
            <StackPanel>
                <TextBlock x:Uid="ConvOutputLabel" Text="OUTPUT DIRECTORY" Style="{StaticResource FieldLabelStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputDirBox" Grid.Column="0" Style="{StaticResource FieldBoxStyle}"
                             Margin="0,0,8,0"/>
                    <Button x:Name="BrowseBtn" x:Uid="ConvBrowseBtn" Grid.Column="1"
                            Style="{StaticResource SecondaryBtnStyle}" Click="OnBrowseClick" Content="Browse"/>
                </Grid>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                <Button x:Name="CancelBtn" x:Uid="ConvCancelBtn" Style="{StaticResource SecondaryBtnStyle}"
                        Click="OnCancelClick" Content="Cancel" MinWidth="96"/>
                <Button x:Name="ConvertBtn" x:Uid="ConvConvertBtn" Style="{StaticResource PrimaryBtnStyle}"
                        Click="OnConvertClick" Content="Convert" MinWidth="120"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
